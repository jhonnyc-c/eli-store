<%- include('partials/header', { title: listing.name + ' — Eli Store' }) %>

<% if (listing.images.length) { %>
  <div class="gallery-main">
    <img id="main-img" src="<%= listing.images[0] %>" alt="<%= listing.name %>" />
  </div>
  <% if (listing.images.length > 1) { %>
    <div class="gallery-thumbs">
      <% listing.images.forEach(function(src, i) { %>
        <img src="<%= src %>" class="<%= i === 0 ? 'active' : '' %>" onclick="showImg(this, '<%= src %>')" />
      <% }) %>
    </div>
  <% } %>
<% } else { %>
  <div class="gallery-main"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#D6336C" stroke-width="1.2"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg></div>
<% } %>

<h1 style="font-size:22px; margin-top:16px;"><%= listing.name %></h1>
<div class="mono" style="font-size:12px; color:var(--muted); margin-top:4px;">
  Vendedor: <%= listing.seller_name %> · <%= listing.category %>
</div>
<% if (listing.description) { %>
  <p style="margin-top:12px; font-size:14px; color:#6b4a58; line-height:1.5;"><%= listing.description %></p>
<% } %>

<div class="split mono">
  <div><span>Precio por unidad</span><span>Bs. <%= listing.price %></span></div>
  <div><span>Disponibles</span><span><%= listing.stock %></span></div>
</div>

<% if (listing.status === 'agotado' || listing.stock <= 0) { %>
  <div class="empty" style="margin-top:16px;">Esta prenda está agotada por ahora.</div>
<% } else if (!user) { %>
  <a class="btn-primary" style="margin-top:16px;" href="/login?next=/product/<%= listing.id %>">Inicia sesión para comprar</a>
<% } else if (user.id === listing.seller_id) { %>
  <div class="notice-box" style="margin-top:16px;">Esta es tu propia prenda publicada.</div>
<% } else { %>
  <form method="GET" action="/checkout/<%= listing.id %>" style="margin-top:16px;">
    <div class="field">
      <label>Cantidad</label>
      <select class="qty-select" name="qty">
        <% for (let i = 1; i <= Math.min(listing.stock, 10); i++) { %>
          <option value="<%= i %>"><%= i %> unidad<%= i > 1 ? 'es' : '' %></option>
        <% } %>
      </select>
    </div>
    <button class="btn-primary" type="submit">Comprar producto</button>
  </form>
<% } %>

<script>
  function showImg(el, src){
    document.getElementById('main-img').src = src;
    document.querySelectorAll('.gallery-thumbs img').forEach(i => i.classList.remove('active'));
    el.classList.add('active');
  }
</script>

<%- include('partials/footer') %>
