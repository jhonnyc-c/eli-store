<%- include('partials/header', { title: 'Tu panel — Eli Store' }) %>

<h2 style="font-size:22px; margin-bottom:4px;">Hola, <%= user.name %></h2>
<div class="role-badge mono"><%= user.role %></div>

<div class="panel" style="margin-top:18px;">
  <div class="panel-head">📦 Mis prendas publicadas</div>
  <% if (myListings.length === 0) { %>
    <div class="empty" style="color:#e4b9cb;">Aún no has publicado nada.</div>
  <% } else { %>
    <% myListings.forEach(function(l) { %>
      <div class="row">
        <span class="rn"><%= l.name %></span>
        <span class="<%= l.status === 'agotado' ? 'status-sold' : 'status-listed' %>"><%= l.status === 'agotado' ? 'Agotado' : 'En venta' %></span>
        <span>Stock: <%= l.stock %></span>
      </div>
    <% }) %>
  <% } %>
  <div class="total">
    <span class="mono" style="font-size:13px; color:#e4b9cb;">📈 Ganancia total (ventas pagadas)</span>
    <span class="val">Bs. <%= totalEarnings %></span>
  </div>
</div>

<form method="POST" action="/logout" style="margin-top:16px;">
  <button class="btn-secondary" type="submit">Cerrar sesión</button>
</form>

<section class="block">
  <h2>Mis compras</h2>
  <% if (myPurchases.length === 0) { %>
    <div class="empty">Aún no has comprado nada.</div>
  <% } else { %>
    <% myPurchases.forEach(function(o) { %>
      <a href="/receipt/<%= o.id %>" class="card" style="display:block; margin-bottom:10px;">
        <div class="row" style="border-top:none; padding-top:0;">
          <span class="rn"><strong><%= o.listing_name %></strong></span>
          <span>Bs. <%= o.total_price.toFixed(2) %></span>
        </div>
        <div class="cseller mono">
          <%= o.quantity %> unidad<%= o.quantity > 1 ? 'es' : '' %> ·
          <span class="<%= o.status === 'pagado' ? 'status-sold' : 'status-pending' %>">
            <%= o.status === 'pagado' ? 'Pagado' : (o.status === 'pendiente_pago' ? 'Pendiente de pago' : 'Cancelado') %>
          </span>
        </div>
      </a>
    <% }) %>
  <% } %>
</section>

<%- include('partials/footer') %>
